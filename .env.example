# ============================================================
#  Т-Инвестиции × DeepSeek — пример конфигурации
#  Скопируйте в .env и заполните своими значениями:
#      cp .env.example .env
#  .env в git не попадает (см. .gitignore).
# ============================================================

# ------------------------------------------------------------
# 1. Т-Инвестиции (T-Invest API)
# ------------------------------------------------------------
# Read-only токен: приложение «Инвестиции» → профиль → «Настройки» →
# «Токены для API». Доступ «только чтение» — торговые методы не используются.
TINVEST_TOKEN=

# true  — работать через песочницу (sandbox-invest-public-api.tinkoff.ru)
# false — боевой контур (реальные данные счёта, осторожно!)
# Для песочницы нужен ОТДЕЛЬНЫЙ токен, созданный в разделе «Песочница».
TINVEST_SANDBOX=true

# Необязательно: id счёта по умолчанию (иначе берётся первый доступный).
TINVEST_ACCOUNT_ID=

# ------------------------------------------------------------
# 2. DeepSeek (OpenAI-совместимый API)
# ------------------------------------------------------------
# Ключ: https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# Базовый URL API. Именно api.deepseek.com (без /v1 — SDK добавит сам).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-chat — поддерживает Function Calling (используется по умолчанию).
# deepseek-reasoner — «думающая» модель, но БЕЗ вызова инструментов.
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# 3. Поведение ассистента
# ------------------------------------------------------------
# Вотчлист для сценария «какие бумаги недооценены по P/E и ROE».
WATCHLIST=SBER,GAZP,LKOH,YDEX,OZON

# Демо-режим: синтетические данные + сценарные ответы, без ключей и сети.
DEMO_MODE=false

# Стриминг ответа токенами (true) или готовый ответ с markdown (false).
STREAM=false

# Максимум раундов вызова инструментов на один вопрос.
MAX_TOOL_ROUNDS=8

# Температура модели (0 — максимально детерминированно).
TEMPERATURE=0.2

# Сколько последних сообщений диалога держать в контексте.
HISTORY_LIMIT=12

# ------------------------------------------------------------
# 4. Сеть, повторы, кэш
# ------------------------------------------------------------
# Таймаут запроса к DeepSeek, секунды.
REQUEST_TIMEOUT=90

# Количество попыток на один вызов API (ретраи с экспоненциальной задержкой).
API_RETRIES=3

# TTL кэша рыночных данных (свечи, цены), секунды. 0 — выключить.
CACHE_TTL=60

# Максимум позиций, по которым считается доходность в get_performance.
MAX_PERFORMANCE_POSITIONS=20

# ------------------------------------------------------------
# 5. Логи
# ------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Необязательно: путь к файлу логов (секреты вырезаются автоматически).
LOG_FILE=
